@using HnHMapperServer.Core.DTOs
@using HnHMapperServer.Core.Enums
@using HnHMapperServer.Core.Extensions
@using HnHMapperServer.Web.Models
@inject IHttpClientFactory HttpClientFactory
@inject ISnackbar Snackbar
@inject IDialogService DialogService

<MudPaper Class="pa-4">
    <MudStack Spacing="3">
        <MudText Typo="Typo.h5">
            <MudIcon Icon="@Icons.Material.Filled.People" Class="me-2" />
            User Management
        </MudText>

        <MudAlert Severity="Severity.Info" Dense="true">
            View all users and their tenant memberships. Add users to additional tenants or remove them from tenants.
        </MudAlert>

        <MudTextField @bind-Value="_searchText"
                      Placeholder="Search by username, email, or discord..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Immediate="true"
                      DebounceInterval="300"
                      Class="mb-2" />

        @if (_loading)
        {
            <div class="d-flex justify-center align-center" style="min-height: 300px;">
                <MudProgressCircular Indeterminate="true" Size="Size.Large" />
            </div>
        }
        else if (FilteredUsers.Count == 0)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-4">
                No users found.
            </MudAlert>
        }
        else
        {
            <MudTable Items="FilteredUsers"
                      Hover="true"
                      Breakpoint="Breakpoint.Sm"
                      Dense="true"
                      Elevation="0"
                      Class="mt-2">
                <HeaderContent>
                    <MudTh>Username</MudTh>
                    <MudTh>Email</MudTh>
                    <MudTh>Discord</MudTh>
                    <MudTh>Tenants</MudTh>
                    <MudTh>Registered</MudTh>
                    <MudTh Style="text-align: right;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Username">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                            <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Class="me-1" />
                            <MudText>@context.Username</MudText>
                            @if (context.IsSuperAdmin)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">SuperAdmin</MudChip>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd DataLabel="Email">
                        <MudText Typo="Typo.body2">@(context.Email ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Discord">
                        <MudText Typo="Typo.body2">@(context.DiscordName ?? "—")</MudText>
                    </MudTd>
                    <MudTd DataLabel="Tenants">
                        @if (context.Tenants.Count == 0)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">Unassigned</MudChip>
                        }
                        else
                        {
                            <MudStack Spacing="1">
                                @foreach (var tenant in context.Tenants)
                                {
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(tenant.PendingApproval ? Color.Warning : Color.Primary)"
                                                 Variant="Variant.Filled">
                                            @tenant.TenantName
                                        </MudChip>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@tenant.Role</MudText>
                                        @if (tenant.PendingApproval)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.HourglassEmpty" Size="Size.Small" Color="Color.Warning" />
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.RemoveCircleOutline"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => ConfirmRemoveFromTenant(context, tenant))"
                                                       Title="Remove from tenant" />
                                    </MudStack>
                                }
                            </MudStack>
                        }
                    </MudTd>
                    <MudTd DataLabel="Registered">
                        @if (context.CreatedAt.HasValue)
                        {
                            <MudText Typo="Typo.body2">@context.CreatedAt.Value.ToString("yyyy-MM-dd")</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary">—</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Actions" Style="text-align: right;">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   OnClick="@(() => OpenAddToTenantDialog(context))"
                                   StartIcon="@Icons.Material.Filled.GroupAdd">
                            Add to Tenant
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Default"
                   OnClick="LoadUsers"
                   StartIcon="@Icons.Material.Filled.Refresh"
                   Disabled="@_loading"
                   Class="mt-2">
            Refresh
        </MudButton>
    </MudStack>
</MudPaper>

@code {
    private List<UserWithTenantsViewModel> _users = new();
    private List<TenantListDto> _tenants = new();
    private bool _loading = true;
    private string _searchText = string.Empty;

    private List<UserWithTenantsViewModel> FilteredUsers =>
        string.IsNullOrWhiteSpace(_searchText)
            ? _users
            : _users.Where(u =>
                u.Username.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ||
                (u.Email?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (u.DiscordName?.Contains(_searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
                u.Tenants.Any(t => t.TenantName.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            ).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadUsers();
        await LoadTenants();
    }

    private async Task LoadUsers()
    {
        _loading = true;

        try
        {
            var apiClient = HttpClientFactory.CreateClient("API");
            var response = await apiClient.GetAsync("/api/superadmin/users/with-tenants");

            if (response.IsSuccessStatusCode)
            {
                var users = await response.Content.ReadFromJsonAsync<List<UserWithTenantsViewModel>>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _users = users ?? new List<UserWithTenantsViewModel>();
            }
            else
            {
                Snackbar.Add($"Failed to load users: {response.StatusCode}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading users: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadTenants()
    {
        try
        {
            var apiClient = HttpClientFactory.CreateClient("API");
            var response = await apiClient.GetAsync("/api/superadmin/tenants");

            if (response.IsSuccessStatusCode)
            {
                var tenants = await response.Content.ReadFromJsonAsync<List<TenantListDto>>(
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });

                _tenants = tenants ?? new List<TenantListDto>();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading tenants: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAddToTenantDialog(UserWithTenantsViewModel user)
    {
        // Filter out tenants the user already belongs to
        var existingTenantIds = user.Tenants.Select(t => t.TenantId).ToHashSet();
        var availableTenants = _tenants.Where(t => !existingTenantIds.Contains(t.Id)).ToList();

        if (availableTenants.Count == 0)
        {
            Snackbar.Add("This user is already a member of all tenants.", Severity.Info);
            return;
        }

        var parameters = new DialogParameters
        {
            ["User"] = new UnassignedUserDto
            {
                UserId = user.UserId,
                Username = user.Username,
                DiscordName = user.DiscordName,
                RegisteredAt = user.CreatedAt
            },
            ["Tenants"] = availableTenants
        };

        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true
        };

        var dialog = await DialogService.ShowAsync<AssignUserDialog>("Add User to Tenant", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await LoadUsers();
        }
    }

    private async Task ConfirmRemoveFromTenant(UserWithTenantsViewModel user, UserTenantMembershipViewModel tenant)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "Remove from tenant?",
            $"Remove user '{user.Username}' from tenant '{tenant.TenantName}'?",
            yesText: "Remove",
            cancelText: "Cancel");

        if (confirmed != true)
            return;

        try
        {
            var apiClient = HttpClientFactory.CreateClient("API");
            var response = await apiClient.DeleteAsync($"/api/superadmin/users/{user.UserId}/tenants/{tenant.TenantId}");

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"User '{user.Username}' removed from '{tenant.TenantName}'", Severity.Success);
                await LoadUsers();
            }
            else
            {
                var body = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to remove user: {response.StatusCode} {body}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error removing user: {ex.Message}", Severity.Error);
        }
    }

    public class UserWithTenantsViewModel
    {
        public string UserId { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string? Email { get; set; }
        public string? DiscordName { get; set; }
        public DateTime? CreatedAt { get; set; }
        public bool IsSuperAdmin { get; set; }
        public List<UserTenantMembershipViewModel> Tenants { get; set; } = new();
    }

    public class UserTenantMembershipViewModel
    {
        public string TenantId { get; set; } = string.Empty;
        public string TenantName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
        public List<string> Permissions { get; set; } = new();
        public DateTime JoinedAt { get; set; }
        public bool PendingApproval { get; set; }
    }
}
